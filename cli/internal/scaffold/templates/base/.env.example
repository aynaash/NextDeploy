# Server secrets — set with `nextdeploy secrets set <KEY> <VALUE>` (never commit).
# AUTH_SECRET signs the session cookie the edge guard verifies.
AUTH_SECRET=replace-with-a-long-random-string
# BYO Postgres / Hyperdrive (--db=byo): set via `nextdeploy secrets set DATABASE_URL <url>` or export locally for `nextdeploy apply`.
# DATABASE_URL=postgres://user:password@host:5432/dbname
