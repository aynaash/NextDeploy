FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV container=docker

# 1. Install systemd, OpenSSH, curl, sudo, tar, procps, and networking tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd systemd-sysv openssh-server sudo curl wget ca-certificates \
    iproute2 net-tools procps tar gzip && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# 2. Optimize systemd inside Docker (disable unnecessary units to boot in <1s)
RUN find /etc/systemd/system \
    /lib/systemd/system \
    -path '*.wants/*' \
    -not -name '*journald*' \
    -not -name '*systemd-tmpfiles*' \
    -not -name '*systemd-user-sessions*' \
    -exec rm \{} \;

# 3. Configure SSH with public key authentication
RUN mkdir -p /var/run/sshd /root/.ssh && \
    chmod 700 /root/.ssh && \
    echo "PermitRootLogin yes" >> /etc/ssh/sshd_config && \
    echo "PubkeyAuthentication yes" >> /etc/ssh/sshd_config && \
    echo "PasswordAuthentication no" >> /etc/ssh/sshd_config

COPY test_ed25519.pub /root/.ssh/authorized_keys
RUN chmod 600 /root/.ssh/authorized_keys

# 4. Install Node.js 22 LTS & Bun runtime
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    curl -fsSL https://bun.sh/install | bash && \
    mv /root/.bun/bin/bun /usr/local/bin/bun && \
    chmod 755 /usr/local/bin/bun

# 5. Install nextdeployd daemon binary
COPY bin/nextdeployd /usr/local/bin/nextdeployd
RUN chmod 755 /usr/local/bin/nextdeployd

# Create standard NextDeploy directories
RUN mkdir -p /opt/nextdeploy/apps /opt/nextdeploy/uploads /run/nextdeployd

# Enable ssh service on startup
RUN systemctl enable ssh

EXPOSE 22 3000

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
